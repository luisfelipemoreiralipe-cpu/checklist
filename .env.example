# ========================
# Environment Variables
# CheckOps — Sistema de Performance Operacional para Restaurantes
#
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores marcados com <PREENCHER>
# 3. NUNCA faça commit do arquivo .env
# ========================

# ── Servidor ───────────────────────────────────
NODE_ENV=development
PORT=3333

# ── Banco de Dados (PostgreSQL) ─────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DB?schema=public
DATABASE_URL="postgresql://<USUARIO>:<SENHA>@localhost:5432/checklist_db?schema=public"

# ── JWT ─────────────────────────────────────────
# Use uma string aleatória longa (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<GERE_UMA_CHAVE_SEGURA_DE_32_CARACTERES_OU_MAIS>
JWT_EXPIRES_IN=7d

# ── Bcrypt ──────────────────────────────────────
# 10-12 recomendado. Valores maiores são mais lentos mas mais seguros.
BCRYPT_SALT_ROUNDS=12

# ── Logs ────────────────────────────────────────
# Opções: debug | info | warn | error
LOG_LEVEL=info
